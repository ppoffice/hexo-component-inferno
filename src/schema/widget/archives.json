{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/widget/archives.json",
  "description": "Archives widget configurations",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "archives"
    },
    "amount": {
      "type": "integer",
      "description": "Amount of archives to show, with a link to the archive page for the rest. Will show all if not set",
      "nullable": true
    }
  },
  "required": ["type"]
}
