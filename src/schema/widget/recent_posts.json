{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/widget/recent_posts.json",
  "description": "Recent posts widget configurations",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "recent_posts"
    },
    "limit": {
      "type": "integer",
      "description": "Number of recent posts to show. Shows 5 if not set",
      "nullable": true
    }
  },
  "required": ["type"]
}
