{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/widget/categories.json",
  "description": "Categories widget configurations",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "categories"
    },
    "amount": {
      "type": "integer",
      "description": "Amount of top-level categories to show, with a link to the category page for the rest. Will show all if not set",
      "nullable": true
    }
  },
  "required": ["type"]
}
